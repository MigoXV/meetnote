MEETNOTE_BASE_URL=http://192.168.0.222:10001/v1
MEETNOTE_MODEL=spark25
MEETNOTE_API_KEY=local
MEETNOTE_PROVIDER=responses
MEETNOTE_THINKING=false
MEETNOTE_TEMPERATURE=0
MEETNOTE_CORPUS_DIR=/workspace/model-bin/meetnote
MEETNOTE_PORT=8010
MEETNOTE_TOKENIZER_PATH=/workspace/model-bin/XHToken/Spark-X2.5-4B-INT8/tokenizer.json
MEETNOTE_BATCH_TOKENS=768
MEETNOTE_BATCH_SOURCES=12
MEETNOTE_SOURCE_TOKENS=384
MEETNOTE_INPUT_TOKEN_BUDGET=8192
MEETNOTE_CONTEXT_TOKENS=128000
MEETNOTE_MODEL_CONCURRENCY=2
MEETNOTE_BODY_MAX_ITEMS=18

MEETNOTE_FULLTEXT_MAX_ACTIVE=2
MEETNOTE_FULLTEXT_MAX_WAITING=4
MEETNOTE_FULLTEXT_QUEUE_TIMEOUT=600

# 独立 BGE-M3 gRPC 引擎；业务环境不安装 Torch/ONNX Runtime
MEETNOTE_EMBEDDING_ENABLED=true
MEETNOTE_EMBEDDING_TARGET=127.0.0.1:50054
MEETNOTE_EMBEDDING_TIMEOUT=30
MEETNOTE_EMBEDDING_MAX_TOKENS=512
MEETNOTE_EMBEDDING_TOP_K=6
MEETNOTE_EMBEDDING_MIN_SCORE=0.70
MEETNOTE_EMBEDDING_CACHE_ENTRIES=2048
MEETNOTE_EMBEDDING_CACHE_BYTES=16777216
